# Database (Supabase PostgreSQL / Cloud Database)
# Paste your Supabase Connection String (URI) from Supabase Dashboard -> Project Settings -> Database
# Leave blank to fallback to local SQLite for offline development.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Auth secrets - CHANGE THESE, use long random strings in production
JWT_SECRET=change_this_to_a_long_random_string
RESET_TOKEN_SECRET=change_this_to_a_different_long_random_string

# Default admin bootstrap (used only by seed.js, first run)
ADMIN_EMAIL=harshavardhanmamidi89@gmail.com
ADMIN_PASSWORD=prk@2007

# Email (SMTP / SendGrid / Resend / SES - any transactional provider)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="IND Homes Admin <no-reply@indhomes.com>"
